+        )
+        if role == "user":
+            speaker_peer_id = session.user_peer_id
+            addressee_peer_id = session.assistant_peer_id
+            speaker_aliases = identity_aliases.get("user", [])
+            addressee_aliases = identity_aliases.get("assistant", [])
