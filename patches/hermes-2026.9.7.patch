+def _normalize_honcho_identity_label(value: object) -> str | None:
+    """Validate a human-readable alias before it reaches reasoning instructions."""
+    if not isinstance(value, str):
+        return None
+    normalized = " ".join(value.split())
+    if not normalized or len(normalized) > _HONCHO_IDENTITY_MAX_LABEL_LENGTH:
+        return None
+    if normalized.casefold() in _HONCHO_IDENTITY_AMBIGUOUS_LABELS:
+        return None
+    if any(
+        not char.isalnum() and char not in _HONCHO_IDENTITY_LABEL_PUNCTUATION
+        for char in normalized
+    ):
+        return None
+    return normalized
+
+
+def _load_honcho_identity_aliases() -> dict[str, list[str]]:
+    """Load optional local alias hints, rejecting unsafe or ambiguous profiles."""
+    empty = {"user": [], "assistant": []}
+    profile_path = (
+        Path(__file__).resolve().parents[3]
+        / _HONCHO_IDENTITY_PROFILE_RELATIVE_PATH
+    )
+    if not profile_path.exists():
+        return empty
+    if profile_path.is_symlink() or profile_path.parent.is_symlink():
+        logger.warning("Ignoring unsafe Honcho identity profile symlink")
+        return empty
+
+    try:
+        if profile_path.stat().st_mode & 0o077:
+            logger.warning("Ignoring Honcho identity profile with permissions wider than 0600")
+            return empty
+        with profile_path.open(encoding="utf-8") as handle:
+            profile = json.load(handle)
+    except (OSError, ValueError, TypeError) as exc:
+        logger.warning("Ignoring invalid Honcho identity profile: %s", exc)
+        return empty
+
+    if (
+        not isinstance(profile, dict)
+        or profile.get("schema_version") != 1
+        or profile.get("scope") != "single-user"
+    ):
+        logger.warning("Ignoring Honcho identity profile with unsupported schema")
+        return empty
+
+    result: dict[str, list[str]] = {"user": [], "assistant": []}
+    for role in ("user", "assistant"):
+        entry = profile.get(role, {})
+        if not isinstance(entry, dict):
+            return empty
+        values: list[object] = [entry.get("primary")]
+        aliases = entry.get("aliases", [])
+        if not isinstance(aliases, list) or len(aliases) > _HONCHO_IDENTITY_MAX_ALIASES:
+            return empty
+        values.extend(aliases)
+
+        seen: set[str] = set()
+        for raw_value in values:
+            if raw_value in (None, ""):
+                continue
+            label = _normalize_honcho_identity_label(raw_value)
+            if label is None:
+                logger.warning("Ignoring Honcho identity profile with an unsafe alias")
+                return empty
+            key = label.casefold()
+            if key not in seen:
+                seen.add(key)
+                result[role].append(label)
+
+    user_keys = {value.casefold() for value in result["user"]}
+    assistant_keys = {value.casefold() for value in result["assistant"]}
+    if user_keys & assistant_keys:
+        logger.warning("Ignoring Honcho identity profile with cross-peer alias conflicts")
+        return empty
+    return result
+
 
 
