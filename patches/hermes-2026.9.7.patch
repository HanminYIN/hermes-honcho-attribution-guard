+    @staticmethod
+    def _memory_line_key(line: str) -> str:
+        """Return a punctuation-insensitive key for exact duplicate filtering."""
+        text = re.sub(r"^[\s>*#•-]+", "", line).strip().casefold()
+        return re.sub(r"[\W_]+", "", text)
+
+    @classmethod
+    def _is_transient_memory_line(cls, line: str) -> bool:
+        """Recognize a small, conservative set of clearly short-lived facts."""
+        text = re.sub(r"^[\s>*#•-]+", "", line).strip()
+        return any(pattern.fullmatch(text) for pattern in _HONCHO_TRANSIENT_MEMORY_PATTERNS)
+
+    @classmethod
+    def _filter_honcho_memory_text(cls, content: str) -> str:
+        """Remove clearly transient and normalized duplicate lines from retrieved memory."""
+        if not content:
+            return content
+
+        filtered: list[str] = []
+        seen: set[str] = set()
+        previous_blank = False
+        for line in content.splitlines():
+            key = cls._memory_line_key(line)
+            if not key:
+                if filtered and not previous_blank:
+                    filtered.append("")
+                previous_blank = True
+                continue
+            previous_blank = False
+            if cls._is_transient_memory_line(line) or key in seen:
+                continue
+            seen.add(key)
+            filtered.append(line.rstrip())
+        return "\n".join(filtered).strip()
+
+    @classmethod
+    def _filter_honcho_memory_items(cls, items: list[str]) -> list[str]:
+        """Filter transient and duplicate peer-card items while preserving order."""
+        filtered: list[str] = []
+        seen: set[str] = set()
+        for item in items:
+            value = cls._filter_honcho_memory_text(str(item))
+            key = cls._memory_line_key(value)
+            if not value or not key or key in seen:
+                continue
+            seen.add(key)
+            filtered.append(value)
+        return filtered
+
+    @classmethod
+    def _filter_honcho_context(cls, context: dict[str, Any]) -> dict[str, Any]:
+        """Filter derived memory fields while preserving raw messages and result shapes."""
+        result = dict(context)
+        for key in ("summary", "representation", "card", "ai_representation", "ai_card"):
+            value = result.get(key)
+            if isinstance(value, str):
+                result[key] = cls._filter_honcho_memory_text(value)
+            elif isinstance(value, list):
+                result[key] = cls._filter_honcho_memory_items(value)
+        return result
+
+    def _fetch_peer_context(
+        self, peer_id: str, search_query: str | None = None, *, target: str | None = None,
+    ) -> dict[str, Any]:
+        return self._filter_honcho_context(
+            super()._fetch_peer_context(peer_id, search_query, target=target)
+        )
+
+    def get_prefetch_context(
+        self, session_key: str, user_message: str | None = None, *, current_query_only: bool = False,
+    ) -> dict[str, str]:
+        return self._filter_honcho_context(
+            super().get_prefetch_context(
+                session_key, user_message, current_query_only=current_query_only
+            )
+        )
+
+    def get_session_context(self, session_key: str, peer: str = "user") -> dict[str, Any]:
+        return self._filter_honcho_context(super().get_session_context(session_key, peer))
+
